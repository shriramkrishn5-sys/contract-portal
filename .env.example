# Environment Variables for KKeyQik Contract Portal
# Copy this file to .env and fill in your values

# Application
NODE_ENV=production
PORT=3000
SESSION_SECRET=your-super-secret-session-key-change-this

# Database
DB_PATH=./data/contracts.db

# Database Configuration (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# Supabase Storage Configuration
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# SMTP Email Configuration
SMTP_HOST=mail.kkeyqik.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contracts@kkeyqik.com
SMTP_PASS=your-email-password

# Application URL (for generating contract links)
APP_URL=https://contract.kkeyqik.com

# Company Defaults
COMPANY_NAME=KKeyQik Private Limited
COMPANY_ADDRESS=H-235 A, Sector-12, Pratap Vihar, Ghaziabad - 201009
COMPANY_CIN=U73100UP2025PTC224880
COMPANY_GSTIN=09AALCK9039M1ZP
COMPANY_SIGNATORY=Naman Agarwal
COMPANY_DESIGNATION=Director
COMPANY_EMAIL=contact@kkeyqik.com
COMPANY_PHONE=+91 9711120165

# Security
DOCUMENT_HASH_SECRET=your-document-hash-secret-change-this
