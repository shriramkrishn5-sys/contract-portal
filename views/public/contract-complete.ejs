<!-- Stepper (Unmodified) -->
<div class="stepper gsap-stagger">
  <div class="stepper-progress" style="width: 99.99%;"></div>
  <div class="step completed">
    <div class="step-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <div class="step-content">
      <span class="step-number">01</span>
      <span class="step-label">Confirm Details</span>
    </div>
  </div>
  <div class="step completed">
    <div class="step-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <div class="step-content">
      <span class="step-number">02</span>
      <span class="step-label">Review Contract</span>
    </div>
  </div>
  <div class="step completed">
    <div class="step-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
    </div>
    <div class="step-content">
      <span class="step-number">03</span>
      <span class="step-label">Sign & Complete</span>
    </div>
  </div>
  <div class="step active">
    <div class="step-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
    </div>
    <div class="step-content">
      <span class="step-number">04</span>
      <span class="step-label">Completed</span>
    </div>
  </div>
</div>

<div class="card complete-main-card gsap-stagger">
  <!-- 1. Huge Animated Green Checkmark & Confetti Visual Elements -->
  <div class="complete-success-wrapper">
    <div class="confetti-container">
      <span class="confetti-piece p1"></span>
      <span class="confetti-piece p2"></span>
      <span class="confetti-piece p3"></span>
      <span class="confetti-piece p4"></span>
      <span class="confetti-piece p5"></span>
      <span class="confetti-piece p6"></span>
      <script>
  gsap.fromTo(".confetti-piece", 
    { y: -50, opacity: 0 },
    { y: 150, opacity: 1, duration: 2.5, stagger: 0.1, ease: "power2.out" }
  );
</script>

<% if (contract.status !== 'generation_failed' && !(contract.status === 'signed' && contract.signed_pdf_path)) { %>
<script>
  let pollInterval = setInterval(async () => {
    try {
      const res = await fetch('/c/<%= contract.uuid %>/status');
      const data = await res.json();
      if (data.status === 'generation_failed') {
        clearInterval(pollInterval);
        document.getElementById('statusHeader').innerHTML = `
          <h1 class="complete-title" style="color: #ef4444;">Document Generation Failed</h1>
          <p class="complete-subtitle">We received your signature, but encountered an error finalizing the PDF. Our team has been notified and will resolve this shortly.</p>
        `;
        document.getElementById('loadingWrapper').style.display = 'none';
      } else if (data.status === 'signed' && data.signed_pdf_path) {
        clearInterval(pollInterval);
        document.getElementById('statusHeader').innerHTML = `
          <h1 class="complete-title">Contract Signed Successfully!</h1>
          <p class="complete-subtitle">Thank you, <strong><%= contract.client_name || 'Client' %></strong>. A signed copy has been sent to your email address.</p>
        `;
        document.getElementById('loadingWrapper').style.display = 'none';
        document.getElementById('downloadWrapper').style.display = 'block';
      }
    } catch (e) {
      console.error('Polling error', e);
    }
  }, 2000);
      <span class="confetti-piece p7"></span>
      <span class="confetti-piece p8"></span>
    </div>
    <div class="success-icon complete-success-icon">
      <svg width="96" height="96" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="45" class="circle-bg" fill="var(--portal-primary-light)" />
        <circle cx="50" cy="50" r="45" class="circle-ring" stroke="var(--portal-primary)" stroke-width="4" stroke-linecap="round" fill="none"/>
        <path d="M30 50L45 65L70 35" class="checkmark-path" stroke="var(--portal-primary)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>

  <!-- 2 & 3. Title & Subtitle -->
  <div class="complete-header text-center" id="statusHeader">
    <% if (contract.status === 'generation_failed') { %>
      <h1 class="complete-title" style="color: #ef4444;">Document Generation Failed</h1>
      <p class="complete-subtitle">We received your signature, but encountered an error finalizing the PDF. Our team has been notified and will resolve this shortly.</p>
    <% } else if (contract.status === 'signed' && contract.signed_pdf_path) { %>
      <h1 class="complete-title">Contract Signed Successfully!</h1>
      <p class="complete-subtitle">Thank you, <strong><%= contract.client_name || 'Client' %></strong>. A signed copy has been sent to your email address.</p>
    <% } else { %>
      <h1 class="complete-title">Your document is being finalized...</h1>
      <p class="complete-subtitle">Thank you, <strong><%= contract.client_name || 'Client' %></strong>. We are securely generating your signed PDF. This usually takes just a few seconds.</p>
    <% } %>
  </div>

  <!-- 4. Full-Width Green Download Button -->
  <div class="complete-download-wrapper mb-4" id="downloadWrapper" style="display: <%= (contract.status === 'signed' && contract.signed_pdf_path) ? 'block' : 'none' %>;">
    <a href="/c/<%= contract.uuid %>/download" class="btn btn-primary btn-lg w-100 btn-download-pdf">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      Download Signed PDF
    </a>
  </div>
  
  <div class="complete-download-wrapper mb-4 text-center" id="loadingWrapper" style="display: <%= (contract.status === 'generation_failed' || (contract.status === 'signed' && contract.signed_pdf_path)) ? 'none' : 'block' %>;">
     <div style="padding: 1rem; color: var(--text-light);">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="spin-animation" style="margin-right: 8px;">
          <line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
        </svg>
        Preparing PDF...
     </div>
  </div>

  <!-- 5. 4-Column Metadata Grid -->
  <div class="complete-meta-grid mb-4">
    <div class="meta-item">
      <div class="meta-item-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
        <span>Document ID</span>
      </div>
      <div class="meta-item-value font-mono">
        <%= contract.uuid ? (contract.uuid.length > 12 ? contract.uuid.substring(0, 12).toUpperCase() + '...' : contract.uuid.toUpperCase()) : 'N/A' %>
      </div>
    </div>
    
    <div class="meta-item">
      <div class="meta-item-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        <span>Signed On</span>
      </div>
      <div class="meta-item-value">
        <%= new Date().toLocaleString() %>
      </div>
    </div>
    
    <div class="meta-item">
      <div class="meta-item-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Signed By</span>
      </div>
      <div class="meta-item-value">
        <%= contract.client_name || 'Client' %> / <%= contract.client_address || 'Address' %>
      </div>
    </div>

    <div class="meta-item">
      <div class="meta-item-header">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        <span>Copy Sent To</span>
      </div>
      <div class="meta-item-value">
        <%= contract.client_email || 'client email' %>
      </div>
    </div>
  </div>

  <!-- 6. "What's Next?" Green Alert Box -->
  <div class="whats-next-box mb-4">
    <div class="whats-next-header">
      <div class="whats-next-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
      </div>
      <h3 class="whats-next-title">What's Next?</h3>
    </div>
    <p class="whats-next-text">
      Your signed agreement has been officially processed and safely stored in our encrypted document repository. A finalized PDF copy complete with a digital audit trail and timestamp has been emailed to <strong><%= contract.client_email || 'your email' %></strong>. No further action is required on your part.
    </p>
  </div>

  <!-- 7. Small Footer Contact Line -->
  <div class="complete-contact-footer mb-4">
    If you have any questions, please contact us at <a href="mailto:hello@keyqik.com">hello@keyqik.com</a>
  </div>

  <!-- 8. Secure Footer Banner -->
  <div class="secure-footer-banner">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
      <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
    </svg>
    <span>Your signature and data are securely encrypted and stored in compliance with industry standards.</span>
  </div>
</div>

<script src="/js/public/contract-complete.js"></script>
<script>
  // Replace the browser history stack so the back button cannot return to editable pages
  if (window.history && window.history.replaceState) {
    window.history.replaceState(null, '', window.location.href);
    window.addEventListener('popstate', function() {
      window.history.replaceState(null, '', window.location.href);
    });
  }
</script>

