<% 
  // Formatting helpers
  function formatDate(isoString) {
    if (!isoString) return '';
    const d = new Date(isoString);
    return d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) + ', ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute:'2-digit', timeZoneName: 'short' });
  }
  
  function calculateDaysRemaining(expiryIso) {
    if (!expiryIso) return '';
    const diff = new Date(expiryIso).getTime() - new Date().getTime();
    const days = Math.ceil(diff / (1000 * 3600 * 24));
    return days > 0 ? `(${days} days remaining)` : '(Expired)';
  }
  
  // Obfuscate email
  function obfuscateEmail(email) {
    if (!email) return '';
    const parts = email.split('@');
    if (parts.length !== 2) return email;
    const name = parts[0];
    const obfName = name.length > 2 ? name[0] + '***' + name[name.length-1] : name[0] + '***';
    return obfName + '@' + parts[1];
  }

  const senderName = settings?.company_name || 'KKeyQik Private Limited';
%>

<div class="welcome-container gsap-stagger">
  
  <div class="welcome-header text-center mb-5">
    <div class="welcome-icon">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
        <polyline points="10 9 9 9 8 9"></polyline>
      </svg>
    </div>
    <h1 class="welcome-title">You've received a contract</h1>
    <p class="welcome-subtitle">
      <%= senderName %> has sent you a contract to review and sign.<br>
      Please review the agreement carefully before signing.
    </p>
  </div>

  <div class="card welcome-card mb-4">
    <div class="wc-header d-flex justify-content-between align-items-start">
      <div class="d-flex" style="gap: 1.25rem;">
        <div class="doc-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <line x1="10" y1="9" x2="8" y2="9"></line>
          </svg>
        </div>
        <div>
          <h2 class="wc-title"><%= template ? template.name : contract.project_name %></h2>
          <p class="wc-id">CON-<%= contract.uuid.substring(0, 8).toUpperCase() %></p>
        </div>
      </div>
      <div class="status-badge awaiting">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        Awaiting Signature
      </div>
    </div>

    <div class="wc-grid mt-4">
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg></div>
        <div>
          <span class="label">From</span>
          <span class="value"><%= senderName %></span>
        </div>
      </div>
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
        <div>
          <span class="label">Prepared for</span>
          <span class="value"><%= contract.client_name || '[Client]' %></span>
          <span class="sub-value"><%= contract.client_email %></span>
        </div>
      </div>
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></div>
        <div>
          <span class="label">Sent by</span>
          <span class="value"><%= contract.authorized_signatory || 'Admin' %></span>
        </div>
      </div>
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
        <div>
          <span class="label">Expires on</span>
          <span class="value"><%= contract.expires_at ? formatDate(contract.expires_at) : 'No Expiry' %></span>
          <% if(contract.expires_at) { %>
            <span class="sub-value text-green"><%= calculateDaysRemaining(contract.expires_at) %></span>
          <% } %>
        </div>
      </div>
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></div>
        <div>
          <span class="label">Sent on</span>
          <span class="value"><%= formatDate(contract.sent_at || contract.created_at) %></span>
        </div>
      </div>
      <div class="wc-grid-item">
        <div class="wc-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path></svg></div>
        <div>
          <span class="label">Document Details</span>
          <span class="value">1 document • Contract</span>
          <span class="sub-value">1 signature required</span>
        </div>
      </div>
    </div>

    <div class="wc-alert mt-4">
      <div class="alert-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
      <div>
        <strong>This document requires your signature.</strong>
        <p>Please review all pages carefully before signing.</p>
      </div>
    </div>
  </div>

  <div class="card email-card mb-4 d-flex justify-content-between align-items-center">
    <div class="d-flex align-items-center" style="gap: 1rem;">
      <div class="email-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle><polyline points="16 11 18 13 22 9"></polyline></svg>
      </div>
      <div>
        <strong style="font-size: 1.05rem; color: var(--portal-dark);">Is this your email address?</strong>
        <p style="margin: 0; color: var(--portal-text-muted); font-size: 0.95rem;">This contract was sent to <%= obfuscateEmail(contract.client_email) %></p>
      </div>
    </div>
    <button class="btn btn-outline" onclick="alert('Please contact the sender if this is not your email address.')">Not my email</button>
  </div>

  <div class="actions text-center mb-5">
    <a href="/c/<%= contract.uuid %>/fill" class="btn btn-primary btn-lg w-100 mb-3" style="font-size: 1.15rem; gap: 0.5rem;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
      Provide Details
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
    </a>
    
    <form action="/c/<%= contract.uuid %>/decline" method="POST" style="margin: 0;">
      <button type="submit" class="btn btn-outline-danger w-100" style="font-size: 1.1rem; gap: 0.5rem;" onclick="return confirm('Are you sure you want to decline this contract?');">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        Decline Contract
      </button>
    </form>

    <div class="text-muted mt-4" style="font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      You can download a copy after signing.
    </div>
  </div>

  <div class="features-card">
    <div class="feature-col">
      <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg></div>
      <div class="feature-text">
        <strong>Secure & Trusted</strong>
        <p>Your data and signatures are protected with enterprise grade security.</p>
      </div>
    </div>
    <div class="feature-col">
      <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg></div>
      <div class="feature-text">
        <strong>Legally Binding</strong>
        <p>This is a legally binding electronic signature and is enforceable.</p>
      </div>
    </div>
    <div class="feature-col">
      <div class="feature-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg></div>
      <div class="feature-text">
        <strong>Audit Trail</strong>
        <p>All signing activities are recorded for security and compliance.</p>
      </div>
    </div>
</div>
