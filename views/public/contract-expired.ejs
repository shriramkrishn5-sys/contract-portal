<div class="card text-center gsap-stagger utility-card" style="width: min(95vw, 540px); margin: 2rem auto; padding: clamp(2rem, 5vw, 3.5rem 2.5rem); border-radius: 12px; border: 1px solid var(--portal-border);">
  <div style="font-size: clamp(3rem, 6vw, 4rem); color: #dc3545; margin-bottom: 1rem;">⚠️</div>
  <h2 class="mb-3" style="font-weight: 700; color: var(--portal-dark); font-size: clamp(1.4rem, 4vw, 1.75rem);">Link Expired</h2>
  <p class="text-muted mb-4" style="font-size: clamp(0.95rem, 2.5vw, 1.1rem); line-height: 1.5;">
    The time allowed to view or sign this contract has passed. For security, contract links expire after a set period.
  </p>
  
  <form action="/c/<%= contract.uuid %>/request-resend" method="POST" class="mb-4">
    <button type="submit" class="btn btn-primary btn-lg w-100" style="border-radius: 8px; font-weight: 600;">
      Request a New Link
    </button>
  </form>

  <div class="mt-4 pt-4 border-top text-muted" style="font-size: 0.875rem;">
    If you need immediate assistance, contact us at <a href="mailto:contract@kkeyqik.com" style="color: var(--portal-primary); text-decoration: none; font-weight: 600;">contract@kkeyqik.com</a>
  </div>
</div>
