<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contract Signed</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background-color: #f3f4f6; color: #1f2937; -webkit-font-smoothing: antialiased;">
    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f3f4f6; padding: 40px 20px;">
        <tr>
            <td align="center">
                <!-- Main Container -->
                <table border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 600px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);">
                    
                    <!-- Header -->
                    <tr>
                        <td align="center" style="background-color: <%= locals.settings?.brand_primary_color || '#059669' %>; padding: 40px 20px; color: #ffffff;">
                            <% if (locals.settings && locals.settings.company_logo) { %>
                                <img src="<%= locals.settings.company_logo %>" alt="<%= locals.settings.company_name || 'Company Logo' %>" style="max-height: 50px; margin-bottom: 15px; display: block; margin-left: auto; margin-right: auto;">
                            <% } %>
                            <div style="margin-bottom: 15px;">
                                <!-- Success Checkmark Icon -->
                                <img src="https://img.icons8.com/ios-filled/50/ffffff/checked--v1.png" alt="Success" width="40" height="40" style="display: block; margin: 0 auto;">
                            </div>
                            <h1 style="margin: 0; font-size: 24px; font-weight: 700;">Document Completed</h1>
                        </td>
                    </tr>
                    
                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 40px;">
                            <p style="font-size: 16px; line-height: 1.6; color: #4b5563; margin-top: 0;">Dear <strong><%= contract.clientName %></strong>,</p>
                            
                            <p style="font-size: 16px; line-height: 1.6; color: #4b5563;">Thank you for completing the signing process. The document has been successfully signed by all parties.</p>
                            
                            <p style="font-size: 16px; line-height: 1.6; color: #4b5563; font-weight: 600;">A legally binding copy of your signed document and audit trail is attached to this email as a PDF.</p>
                            
                            <!-- Document Details Box -->
                            <table border="0" cellpadding="20" cellspacing="0" width="100%" style="background-color: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; margin: 30px 0;">
                                <tr>
                                    <td>
                                        <p style="margin: 0 0 10px 0; font-size: 13px; text-transform: uppercase; color: #059669; font-weight: 600; letter-spacing: 0.5px;">Summary</p>
                                        <p style="margin: 0 0 8px 0; font-size: 16px; color: #064e3b;"><strong><%= contract.projectName || contract.title %></strong></p>
                                        <p style="margin: 0; font-size: 14px; color: #047857;">Signed on: <%= new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
                                    </td>
                                </tr>
                            </table>
                            
                            <p style="font-size: 14px; color: #6b7280; text-align: center; margin-top: 30px;">Please download and retain the attached PDF for your permanent records.</p>
                        </td>
                    </tr>
                    
                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background-color: #f8fafc; padding: 30px 40px; font-size: 13px; color: #94a3b8; border-top: 1px solid #f1f5f9;">
                            <p style="margin: 0 0 10px 0; font-weight: 600; color: #64748b;"><%= locals.settings?.company_name || 'KKeyQik Private Limited' %></p>
                            <p style="margin: 0;"><%= locals.settings?.smtp_from_email || locals.settings?.company_email || 'contracts@kkeyqik.com' %></p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
