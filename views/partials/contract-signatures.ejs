        <!-- Signature Section -->
        <div class="signature-section" style="margin-top: 80px;">
            <div class="signature-block">
                <div class="signature-area">
                    <% if (settings?.company_signature) { %>
                        <img src="<%= settings.company_signature %>" class="signature-img" alt="Authorized Signature" loading="lazy" decoding="async" style="mix-blend-mode: multiply; transform: scale(1.8); transform-origin: left bottom; margin-left: 10px;">
                    <% } else { %>
                        <div class="signature-text" style="font-family: 'Dancing Script', cursive, serif; font-size: 24pt; color: var(--primary);">
                            <%= settings?.authorized_signatory || contract.authorized_signatory || 'Naman Agarwal' %>
                        </div>
                    <% } %>
                </div>
                <div class="signature-meta">
                    <p style="font-weight: 600; color: var(--text-dark); font-size: 11pt;"><%= settings?.authorized_signatory || contract.authorized_signatory || 'Naman Agarwal' %></p>
                    <p>Director</p>
                    <p><%= settings?.company_name || 'KKeyQik Private Limited' %></p>
                    <% if (typeof audit !== 'undefined' && audit && audit.timestamp) { %>
                        <p>Date: <%= new Date(audit.timestamp).toLocaleDateString() %></p>
                    <% } else { %>
                        <p>Date: <%= contract.created_at ? new Date(contract.created_at).toLocaleDateString() : '________________' %></p>
                    <% } %>
                </div>
            </div>
            
            <div class="signature-block">
                <div class="signature-area">
                    <% if (typeof signature !== 'undefined' && signature) { %>
                        <% if (signature.image || signature.data) { %>
                            <img src="<%= signature.image || signature.data %>" class="signature-img" alt="Signature" loading="lazy" decoding="async">
                        <% } else if (signature.text) { %>
                            <div class="signature-text" style="font-family: <%= signature.fontFamily || 'cursive' %>;"><%= signature.text %></div>
                        <% } %>
                    <% } %>
                </div>
                <div class="signature-meta">
                    <% if (contract.client_type !== 'individual') { %>
                        <p style="font-weight: 600; color: var(--text-dark); font-size: 11pt;"><%= contract.client_selections?.client_signatory_name || contract.client_name || 'Authorized Signatory' %></p>
                        <p><%= contract.client_designation || 'Authorized Signatory' %></p>
                        <% if (contract.client_company) { %>
                            <p><%= contract.client_company %></p>
                        <% } %>
                    <% } else { %>
                        <p style="font-weight: 600; color: var(--text-dark); font-size: 11pt;"><%= contract.client_name || 'Client' %></p>
                        <% if (contract.client_designation) { %>
                            <p><%= contract.client_designation %></p>
                        <% } %>
                    <% } %>
                    <% if (typeof audit !== 'undefined' && audit && audit.timestamp) { %>
                        <p>Date: <%= new Date(audit.timestamp).toLocaleDateString() %></p>
                    <% } else { %>
                        <p>Date: ________________</p>
                    <% } %>
                </div>
            </div>
        </div>
