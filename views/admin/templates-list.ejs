<!-- Simple Modals for Import / Upload -->
<div id="importModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding: 1rem;">
  <div style="background:white; padding:24px; border-radius:12px; width: min(92vw, 480px); max-height: 90vh; overflow-y: auto; margin: 20px auto;">
    <h3 style="margin-top: 0; margin-bottom: 16px;">Import DOCX</h3>
    <form action="/admin/templates/import" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:16px;">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" style="width:100%;" required>
      </div>
      <div style="margin-bottom:16px;">
        <label class="form-label">File (.docx)</label>
        <input type="file" name="file" accept=".docx" class="form-control" style="width:100%;" required>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top: 24px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('importModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Import</button>
      </div>
    </form>
  </div>
</div>

<div id="uploadModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center; padding: 1rem;">
  <div style="background:white; padding:24px; border-radius:12px; width: min(92vw, 480px); max-height: 90vh; overflow-y: auto; margin: 20px auto;">
    <h3 style="margin-top: 0; margin-bottom: 16px;">Upload JSON/HTML</h3>
    <form action="/admin/templates/upload" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:16px;">
        <label class="form-label">Name</label>
        <input type="text" name="name" class="form-control" style="width:100%;" required>
      </div>
      <div style="margin-bottom:16px;">
        <label class="form-label">File (.json or .html)</label>
        <input type="file" name="file" accept=".json,.html" class="form-control" style="width:100%;" required>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px; margin-top: 24px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('uploadModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload</button>
      </div>
    </form>
  </div>
</div>

<!-- Mobile 'New Template' Bottom Sheet Modal -->
<div id="newTemplateActionSheet" class="mt-sheet-backdrop" onclick="closeNewTemplateSheet(event)">
  <div class="mt-action-sheet" onclick="event.stopPropagation()">
    <div class="mt-sheet-handle"></div>
    <div class="mt-sheet-header">
      <div class="mt-sheet-title">Create Template</div>
      <button type="button" class="mt-sheet-close" onclick="closeNewTemplateSheet(event)" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="mt-sheet-options">
      <form method="POST" action="/admin/templates" style="margin: 0; width: 100%;">
        <button type="submit" class="mt-opt-btn">
          <div class="mt-opt-icon" style="background: #ECFDF5; color: #10B981;">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </div>
          <div class="mt-opt-info">
            <div class="mt-opt-title">Blank Template</div>
            <div class="mt-opt-desc">Create from scratch using the template editor</div>
          </div>
        </button>
      </form>

      <button type="button" class="mt-opt-btn" onclick="closeNewTemplateSheet(); document.getElementById('importModal').style.display='flex';">
        <div class="mt-opt-icon" style="background: #EFF6FF; color: #3B82F6;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="12" y1="18" x2="12" y2="12"></line>
            <line x1="9" y1="15" x2="15" y2="15"></line>
          </svg>
        </div>
        <div class="mt-opt-info">
          <div class="mt-opt-title">Import DOCX</div>
          <div class="mt-opt-desc">Upload Word .docx to automatically convert</div>
        </div>
      </button>

      <button type="button" class="mt-opt-btn" onclick="closeNewTemplateSheet(); document.getElementById('uploadModal').style.display='flex';">
        <div class="mt-opt-icon" style="background: #FEF3C7; color: #D97706;">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <div class="mt-opt-info">
          <div class="mt-opt-title">Upload JSON / HTML</div>
          <div class="mt-opt-desc">Import existing template schemas directly</div>
        </div>
      </button>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- 1. DESKTOP VIEW (>768px)                   -->
<!-- ========================================== -->
<div class="desktop-templates-view">
  <div class="header-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 30px;">
    <div>
      <h1 class="page-title">Template Editor</h1>
      <p class="page-subtitle">Design and configure contract templates</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 10px;">
      <button class="btn btn-outline" onclick="document.getElementById('importModal').style.display='flex'">Import DOCX</button>
      <button class="btn btn-outline" onclick="document.getElementById('uploadModal').style.display='flex'">Upload JSON/HTML</button>
      <form method="POST" action="/admin/templates" style="margin: 0;">
        <button type="submit" class="btn btn-primary">Create Blank</button>
      </form>
    </div>
  </div>

  <div class="template-grid-responsive">
    <% templates.forEach(template => { %>
      <div class="template-card" style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; display: flex; flex-direction: column; height: 100%;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
          <div style="width: 48px; height: 48px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 24px; flex-shrink: 0;">
            <%= template.icon %>
          </div>
          <div style="min-width: 0; word-break: break-word;">
            <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #0f172a;"><%= template.name %></h3>
            <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">v<%= template.version %></p>
          </div>
        </div>
        <p style="font-size: 14px; color: #475569; margin: 0 0 24px; flex-grow: 1; line-height: 1.5; word-break: break-word;">
          <%= template.description %>
        </p>
        <div style="display: flex; gap: 8px; margin-top: auto;">
          <a href="/admin/contracts/create/<%= template.slug %>" class="btn btn-primary" style="flex: 1; justify-content: center;">Use Template</a>
          <a href="/admin/templates/<%= template.id %>/edit" class="btn btn-outline" style="justify-content: center;" title="Edit Structure">Edit</a>
          <button type="button" class="btn btn-outline" style="color: #dc2626; border-color: #fca5a5; padding: 0 12px;" onclick="deleteTemplate(<%= template.id %>, '<%= template.name.replace(/'/g, "\\'") %>')" title="Delete Template">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          </button>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<!-- ========================================== -->
<!-- 2. MOBILE VIEW (<=768px)                   -->
<!-- ========================================== -->
<div class="mobile-templates-view">
  <!-- Top Header Row with Page Title and New Template Button -->
  <div class="mt-header-row">
    <div class="mt-title-group">
      <h1 class="mt-page-title">Templates</h1>
      <p class="mt-page-subtitle">Create contracts faster with ready-to-use templates.</p>
    </div>
    <button type="button" class="mt-new-btn" onclick="openNewTemplateSheet()">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>New Template</span>
    </button>
  </div>

  <!-- Search & Filter Controls Bar -->
  <div class="mt-search-bar-row">
    <div class="mt-search-input-wrap">
      <svg class="mt-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="mtSearchInput" class="mt-search-input" placeholder="Search templates..." oninput="handleTemplateSearch(this.value)">
    </div>
    <button type="button" class="mt-filter-btn" onclick="openNewTemplateSheet()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="4" y1="21" x2="4" y2="14"></line>
        <line x1="4" y1="10" x2="4" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12" y2="3"></line>
        <line x1="20" y1="21" x2="20" y2="16"></line>
        <line x1="20" y1="12" x2="20" y2="3"></line>
        <line x1="1" y1="14" x2="7" y2="14"></line>
        <line x1="9" y1="8" x2="15" y2="8"></line>
        <line x1="17" y1="16" x2="23" y2="16"></line>
      </svg>
      <span>Filter</span>
    </button>
  </div>

  <!-- Category Segmented Filter Tabs (Horizontally Scrollable) -->
  <div class="mt-category-bar" id="mtCategoryBar">
    <button type="button" class="mt-cat-pill active" data-cat="all" onclick="filterTemplateCategory('all', this)">All Templates</button>
    <button type="button" class="mt-cat-pill" data-cat="business" onclick="filterTemplateCategory('business', this)">Business</button>
    <button type="button" class="mt-cat-pill" data-cat="marketing" onclick="filterTemplateCategory('marketing', this)">Marketing</button>
    <button type="button" class="mt-cat-pill" data-cat="employment" onclick="filterTemplateCategory('employment', this)">Employment</button>
    <button type="button" class="mt-cat-pill" data-cat="other" onclick="filterTemplateCategory('other', this)">Other</button>
  </div>

  <!-- Template Cards List -->
  <div class="mt-list" id="mtTemplateList">
    <% templates.forEach(t => { 
      const nameLower = (t.name || '').toLowerCase();
      let cat = 'Business';
      let catKey = 'business';
      let badgeStyle = 'badge-business';
      let iconBg = '#ECFDF5';
      let iconColor = '#10B981';
      let iconType = 'briefcase';

      if (nameLower.includes('marketing') || nameLower.includes('social') || nameLower.includes('seo') || nameLower.includes('video')) {
        cat = 'Marketing';
        catKey = 'marketing';
        badgeStyle = 'badge-marketing';
        iconBg = '#EFF6FF';
        iconColor = '#3B82F6';
        iconType = 'marketing';
      } else if (nameLower.includes('employment') || nameLower.includes('hr') || nameLower.includes('employee') || nameLower.includes('staff')) {
        cat = 'Employment';
        catKey = 'employment';
        badgeStyle = 'badge-employment';
        iconBg = '#FFFBEB';
        iconColor = '#F59E0B';
        iconType = 'employment';
      } else if (nameLower.includes('nda') || nameLower.includes('disclosure') || nameLower.includes('confidential')) {
        cat = 'Business';
        catKey = 'business';
        badgeStyle = 'badge-business';
        iconBg = '#F5F3FF';
        iconColor = '#8B5CF6';
        iconType = 'nda';
      } else if (nameLower.includes('partnership') || nameLower.includes('consult')) {
        cat = 'Business';
        catKey = 'business';
        badgeStyle = 'badge-business';
        iconBg = '#ECFDF5';
        iconColor = '#10B981';
        iconType = 'partnership';
      } else if (nameLower.includes('web') || nameLower.includes('app') || nameLower.includes('dev')) {
        cat = 'Business';
        catKey = 'business';
        badgeStyle = 'badge-business';
        iconBg = '#ECFDF5';
        iconColor = '#10B981';
        iconType = 'code';
      }

      let pageCount = 6;
      try {
        if (t.content_sections) {
          const secs = typeof t.content_sections === 'string' ? JSON.parse(t.content_sections) : t.content_sections;
          if (Array.isArray(secs) && secs.length > 0) pageCount = secs.length;
        }
      } catch(e) {}
    %>
      <div class="mt-card" data-cat="<%= catKey %>" data-title="<%= nameLower %>">
        <a href="/admin/contracts/create/<%= t.slug %>" class="mt-card-left">
          <div class="mt-card-icon" style="background: <%= iconBg %>; color: <%= iconColor %>;">
            <% if (iconType === 'marketing') { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path>
              </svg>
            <% } else if (iconType === 'code') { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                <line x1="8" y1="21" x2="16" y2="21"></line>
                <line x1="12" y1="17" x2="12" y2="21"></line>
                <polyline points="7 9 5 11 7 13"></polyline>
                <polyline points="13 9 15 11 13 13"></polyline>
              </svg>
            <% } else if (iconType === 'employment') { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            <% } else if (iconType === 'nda') { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            <% } else if (iconType === 'partnership') { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.42 4.58a5.4 5.4 0 0 0-7.65 0l-.77.78-.77-.78a5.4 5.4 0 0 0-7.65 7.65l.77.78 7.65 7.65 7.65-7.65.77-.78a5.4 5.4 0 0 0 0-7.65z"></path>
              </svg>
            <% } else { %>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
            <% } %>
          </div>
          <div class="mt-card-info">
            <div class="mt-card-title"><%= t.name %></div>
            <div class="mt-card-meta">
              <span class="mt-meta-category"><%= cat %></span>
              <span class="mt-meta-dot">•</span>
              <span class="mt-meta-pages"><%= pageCount %> <%= pageCount === 1 ? 'page' : 'pages' %></span>
            </div>
          </div>
        </a>

        <div class="mt-card-right">
          <span class="mt-pill-badge <%= badgeStyle %>"><%= cat %></span>
          <div class="mt-menu-wrapper" style="position: relative;">
            <button type="button" class="mt-kebab-btn" onclick="toggleTmplDropdown(event, <%= t.id %>)" aria-label="Template Actions">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#64748B" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="1"></circle>
                <circle cx="12" cy="5" r="1"></circle>
                <circle cx="12" cy="19" r="1"></circle>
              </svg>
            </button>
            <div id="tmplDropdown_<%= t.id %>" class="mt-dropdown-sheet">
              <a href="/admin/contracts/create/<%= t.slug %>" class="mt-sheet-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                <span>Create Contract</span>
              </a>
              <a href="/admin/templates/<%= t.id %>/edit" class="mt-sheet-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                <span>Edit Template</span>
              </a>
              <button type="button" class="mt-sheet-item" onclick="deleteTemplate(<%= t.id %>, '<%= t.name.replace(/'/g, "\\'") %>')" style="background: none; border: none; width: 100%; cursor: pointer; color: #dc2626; text-align: left; padding: 8px 10px; font-family: inherit; font-size: 0.78rem;">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                <span>Delete Template</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    <% }) %>

    <div id="mtEmptySearch" class="mt-empty-state" style="display: none;">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <div class="mt-empty-title">No matching templates</div>
      <p class="mt-empty-sub">Try searching with another keyword or select a different category.</p>
    </div>
  </div>

  <!-- Bottom Trust & Compliance Card -->
  <div class="mt-trust-banner">
    <div class="mtb-shield-wrap">
      <svg class="mtb-sparkle-1" width="10" height="10" viewBox="0 0 24 24" fill="#1E513A"><path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/></svg>
      <svg class="mtb-sparkle-2" width="8" height="8" viewBox="0 0 24 24" fill="#1E513A"><path d="M12 2L14.4 9.6L22 12L14.4 14.4L12 22L9.6 14.4L2 12L9.6 9.6L12 2Z"/></svg>
      <div class="mtb-shield-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#1E513A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          <polyline points="9 12 11 14 15 10"></polyline>
        </svg>
      </div>
    </div>
    <div class="mtb-content">
      <div class="mtb-title">Save Time. Stay Compliant.</div>
      <div class="mtb-desc">Use templates created by legal experts and customize them as per your needs.</div>
    </div>
    <a href="/admin/templates" class="mtb-btn">Explore Templates</a>
  </div>
</div>

<script>
let currentCategoryFilter = 'all';
let currentSearchQuery = '';

function openNewTemplateSheet() {
  const sheet = document.getElementById('newTemplateActionSheet');
  if (sheet) sheet.style.display = 'flex';
}

function closeNewTemplateSheet(e) {
  if (e) e.stopPropagation();
  const sheet = document.getElementById('newTemplateActionSheet');
  if (sheet) sheet.style.display = 'none';
}

function handleTemplateSearch(query) {
  currentSearchQuery = (query || '').toLowerCase().trim();
  applyTemplateFilters();
}

function filterTemplateCategory(category, buttonEl) {
  currentCategoryFilter = category;
  const pills = document.querySelectorAll('.mt-cat-pill');
  pills.forEach(p => p.classList.remove('active'));
  if (buttonEl) buttonEl.classList.add('active');
  applyTemplateFilters();
}

function applyTemplateFilters() {
  const cards = document.querySelectorAll('.mt-card');
  let visibleCount = 0;

  cards.forEach(card => {
    const cardCat = card.getAttribute('data-cat') || '';
    const cardTitle = card.getAttribute('data-title') || '';

    const matchesCat = (currentCategoryFilter === 'all' || cardCat === currentCategoryFilter);
    const matchesSearch = (!currentSearchQuery || cardTitle.includes(currentSearchQuery));

    if (matchesCat && matchesSearch) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  const emptyEl = document.getElementById('mtEmptySearch');
  if (emptyEl) {
    emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';
  }
}

function toggleTmplDropdown(event, tmplId) {
  event.preventDefault();
  event.stopPropagation();
  const allDropdowns = document.querySelectorAll('.mt-dropdown-sheet');
  allDropdowns.forEach(d => {
    if (d.id !== 'tmplDropdown_' + tmplId) d.classList.remove('show');
  });

  const target = document.getElementById('tmplDropdown_' + tmplId);
  if (target) target.classList.toggle('show');
}

async function deleteTemplate(templateId, templateName) {
  if (!confirm(`Are you sure you want to delete "${templateName}"? This action cannot be undone.`)) {
    return;
  }

  try {
    const res = await fetch(`/admin/templates/${templateId}`, {
      method: 'DELETE',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      }
    });
    const data = await res.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert(data.message || 'Failed to delete template');
    }
  } catch (err) {
    console.error(err);
    alert('An error occurred while deleting the template');
  }
}

document.addEventListener('click', () => {
  const allDropdowns = document.querySelectorAll('.mt-dropdown-sheet');
  allDropdowns.forEach(d => d.classList.remove('show'));
});
