<div class="header-actions" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
  <div>
    <h1 class="page-title">Template Editor</h1>
    <p class="page-subtitle">Design and configure contract templates</p>
  </div>
  <div style="display: flex; gap: 10px;">
    <button class="btn btn-outline" onclick="document.getElementById('importModal').style.display='block'">Import DOCX</button>
    <button class="btn btn-outline" onclick="document.getElementById('uploadModal').style.display='block'">Upload JSON/HTML</button>
    <form method="POST" action="/admin/templates" style="margin: 0;">
      <button type="submit" class="btn btn-primary">Create Blank</button>
    </form>
  </div>
</div>

<!-- Simple Modals (you can use bootstrap modals if bootstrap is loaded, assuming simple display logic) -->
<div id="importModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
  <div style="background:white; padding:24px; border-radius:8px; width:400px; margin: 100px auto;">
    <h3>Import DOCX</h3>
    <form action="/admin/templates/import" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:16px;">
        <label>Name</label>
        <input type="text" name="name" style="width:100%; padding:8px;" required>
      </div>
      <div style="margin-bottom:16px;">
        <label>File (.docx)</label>
        <input type="file" name="file" accept=".docx" style="width:100%; padding:8px;" required>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('importModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Import</button>
      </div>
    </form>
  </div>
</div>

<div id="uploadModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
  <div style="background:white; padding:24px; border-radius:8px; width:400px; margin: 100px auto;">
    <h3>Upload JSON/HTML</h3>
    <form action="/admin/templates/upload" method="POST" enctype="multipart/form-data">
      <div style="margin-bottom:16px;">
        <label>Name</label>
        <input type="text" name="name" style="width:100%; padding:8px;" required>
      </div>
      <div style="margin-bottom:16px;">
        <label>File (.json or .html)</label>
        <input type="file" name="file" accept=".json,.html" style="width:100%; padding:8px;" required>
      </div>
      <div style="display:flex; justify-content:flex-end; gap:8px;">
        <button type="button" class="btn btn-outline" onclick="document.getElementById('uploadModal').style.display='none'">Cancel</button>
        <button type="submit" class="btn btn-primary">Upload</button>
      </div>
    </form>
  </div>
</div>

<div class="template-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
  <% templates.forEach(template => { %>
    <div class="template-card" style="background: white; border-radius: 16px; padding: 24px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; display: flex; flex-direction: column; height: 100%;">
      <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #f8fafc; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: center; font-size: 24px;">
          <%= template.icon %>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 16px; font-weight: 600; color: #0f172a;"><%= template.name %></h3>
          <p style="margin: 4px 0 0; font-size: 13px; color: #64748b;">v<%= template.version %></p>
        </div>
      </div>
      <p style="font-size: 14px; color: #475569; margin: 0 0 24px; flex-grow: 1; line-height: 1.5;">
        <%= template.description %>
      </p>
      <div style="display: flex; gap: 12px;">
        <a href="/admin/templates/<%= template.id %>/edit" class="btn btn-outline" style="flex: 1; justify-content: center;">Edit Structure</a>
      </div>
    </div>
  <% }) %>
</div>
