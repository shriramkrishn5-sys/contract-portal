<div class="card mb-4" style="max-width: 800px; margin: 0 auto;">
  <div class="card-header border-bottom pb-3 mb-4">
    <h2 class="mb-1" style="font-size: 1.5rem; font-weight: 600;">Pre-fill Contract Details</h2>
    <p class="text-muted m-0">Please provide the default parameters for <strong><%= template.name %></strong> before proceeding.</p>
  </div>
  
  <form id="prefillForm" action="/admin/contracts/create/<%= template.slug %>" method="GET">
    
    <!-- Company information is pulled dynamically from Global Settings (res.locals.settings) -->
    <!-- See routes/contracts.js POST /create where this is injected -->


    <div class="section mb-4">
      <h3 class="mb-3" style="font-size: 1.1rem; font-weight: 600; color: var(--portal-primary);">Project Defaults</h3>
      
      <div class="row" style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
        <div class="form-group">
          <label class="form-label text-sm font-medium">Default Amount</label>
          <div class="d-flex">
            <select name="currency" class="form-control" style="width: 80px; margin-right: 0.5rem; border-color: #ddd;">
              <option value="INR">₹ INR</option>
              <option value="USD">$ USD</option>
            </select>
            <input type="number" name="amount" class="form-control" placeholder="e.g. 50000">
          </div>
        </div>
        <div class="form-group">
          <label class="form-label text-sm font-medium">Time Period</label>
          <input type="text" name="timePeriod" class="form-control" placeholder="e.g. 3 Months">
        </div>
      </div>
      
      <div class="form-group">
        <label class="form-label text-sm font-medium">Default Scope of Work</label>
        <textarea name="scopeOfWork" class="form-control" rows="4" placeholder="Briefly outline the standard scope of work for this template..."></textarea>
      </div>
    </div>

    <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
      <a href="/admin/contracts/new" class="btn btn-outline" style="border: 1px solid #ddd; padding: 0.5rem 1rem; border-radius: 6px; text-decoration: none; color: #333;">Cancel</a>
      <button type="submit" class="btn btn-primary" style="padding: 0.5rem 1.5rem;">Continue to Contract</button>
    </div>
  </form>
</div>
