<!-- Retry PDF Generation Script & Mobile Contracts Filter Scripts -->
<script>
async function retryPdfGeneration(contractId) {
  if (!confirm('Are you sure you want to retry generating the PDF for this contract? Make sure you have resolved any signature issues first.')) return;
  
  try {
    const res = await fetch(`/admin/contracts/${contractId}/retry-pdf`, { method: 'POST' });
    const data = await res.json();
    if (res.ok) {
      alert('PDF regeneration triggered successfully. This may take a few seconds in the background.');
      window.location.reload();
    } else {
      alert('Failed to retry: ' + (data.error || 'Unknown error'));
    }
  } catch (err) {
    alert('An error occurred while retrying PDF generation.');
  }
}

let currentMobileStatusFilter = 'all';
let currentMobileSearchQuery = '';

function handleMobileContractSearch(query) {
  currentMobileSearchQuery = (query || '').toLowerCase().trim();
  applyMobileContractFilters();
}

function filterMobileContracts(status, el) {
  currentMobileStatusFilter = status;
  const tabs = document.querySelectorAll('.mc-status-tab');
  tabs.forEach(t => {
    if (t.getAttribute('data-status') === status) {
      t.classList.add('active');
    } else {
      t.classList.remove('active');
    }
  });
  applyMobileContractFilters();
}

function applyMobileContractFilters() {
  const cards = document.querySelectorAll('.mc-card');
  let visibleCount = 0;

  cards.forEach(card => {
    const cardStatus = card.getAttribute('data-status') || '';
    const searchData = card.getAttribute('data-search') || '';

    const matchesStatus = (currentMobileStatusFilter === 'all' || 
      cardStatus === currentMobileStatusFilter || 
      (currentMobileStatusFilter === 'pending' && cardStatus === 'in_review'));

    const matchesSearch = (!currentMobileSearchQuery || searchData.includes(currentMobileSearchQuery));

    if (matchesStatus && matchesSearch) {
      card.style.display = 'flex';
      visibleCount++;
    } else {
      card.style.display = 'none';
    }
  });

  const emptyEl = document.getElementById('mcEmptyState');
  if (emptyEl) {
    emptyEl.style.display = visibleCount === 0 ? 'block' : 'none';
  }
}

function toggleMobileContractDropdown(event, contractId) {
  event.preventDefault();
  event.stopPropagation();
  const allDropdowns = document.querySelectorAll('.mc-dropdown-sheet');
  allDropdowns.forEach(d => {
    if (d.id !== 'mcDropdown_' + contractId) d.classList.remove('show');
  });

  const target = document.getElementById('mcDropdown_' + contractId);
  if (target) target.classList.toggle('show');
}

function copySigningLink(url) {
  const fullUrl = window.location.origin + url;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(fullUrl).then(() => {
      alert('Contract signing link copied to clipboard!');
    }).catch(() => {
      prompt('Copy this link:', fullUrl);
    });
  } else {
    prompt('Copy this link:', fullUrl);
  }
}

async function deleteContractSingle(contractId) {
  if (!confirm('Are you sure you want to permanently delete this contract? This action cannot be undone.')) {
    return;
  }

  try {
    const res = await fetch(`/admin/contracts/${contractId}`, {
      method: 'DELETE',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json'
      }
    });
    const data = await res.json();
    if (data.success) {
      window.location.reload();
    } else {
      alert(data.message || 'Failed to delete contract');
    }
  } catch (err) {
    console.error(err);
    alert('An error occurred while deleting the contract');
  }
}

function toggleMobileFilterOptions() {
  const select = document.getElementById('statusFilter');
  if (select) {
    select.scrollIntoView({ behavior: 'smooth' });
    select.focus();
  }
}

function toggleMobileSortOptions() {
  const list = document.getElementById('mcContractList');
  if (!list) return;
  const cards = Array.from(list.querySelectorAll('.mc-card'));
  cards.reverse().forEach(c => list.appendChild(c));
}

document.addEventListener('click', () => {
  const allDropdowns = document.querySelectorAll('.mc-dropdown-sheet');
  allDropdowns.forEach(d => d.classList.remove('show'));
});
</script>

