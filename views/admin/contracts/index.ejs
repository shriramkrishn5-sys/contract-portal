<div class="desktop-contracts-view contracts-page">
  <!-- Header Section -->
  <div class="page-header mb-4">
    <div>
      <h1 class="page-title">All Contracts</h1>
      <p class="page-subtitle">View, manage and track all your contracts in one place.</p>
    </div>
    <div class="header-actions">
      <a href="/admin/contracts/new" class="btn btn-action btn-new">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Contract
      </a>
      <button class="btn btn-action btn-upload">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Upload Contract
      </button>
    </div>
  </div>

  <!-- Filters Section -->
  <div class="filters-bar mb-4">
    <div class="search-box">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="searchContracts" placeholder="Search contracts..." value="<%= filters && filters.search ? filters.search : '' %>">
    </div>
    
    <div class="filter-dropdowns">
      <select id="statusFilter" class="filter-select">
        <option value="all" <%= filters && filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
        <option value="active" <%= filters && filters.status === 'active' ? 'selected' : '' %>>Active</option>
        <option value="draft" <%= filters && filters.status === 'draft' ? 'selected' : '' %>>Draft</option>
        <option value="completed" <%= filters && filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
        <option value="generation_failed" <%= filters && filters.status === 'generation_failed' ? 'selected' : '' %>>Generation Failed</option>
        <option value="expiring" <%= filters && filters.status === 'expiring' ? 'selected' : '' %>>Expiring Soon</option>
      </select>
      
      <select id="categoryFilter" class="filter-select">
        <option value="all">All Categories</option>
        <option value="service agreement">Service</option>
        <option value="project agreement">Project</option>
        <option value="legal agreement">Legal</option>
        <option value="financial agreement">Financial</option>
      </select>
      
      <select class="filter-select">
        <option>All Parties</option>
      </select>
      
      <div class="date-filter-group d-flex align-items-center gap-2">
        <input type="date" id="startDateFilter" class="filter-select date-input" value="<%= filters && filters.startDate ? filters.startDate : '' %>">
        <span style="color: #64748b; font-size: 14px;">to</span>
        <input type="date" id="endDateFilter" class="filter-select date-input" value="<%= filters && filters.endDate ? filters.endDate : '' %>">
      </div>
      
      <button class="btn-filter" onclick="applyFilters()" style="background: white; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 16px; cursor: pointer;">
        Filter
      </button>
    </div>
  </div>

  <!-- Bulk Actions Bar -->
  <div id="bulkActionBar" class="bulk-action-bar" style="display: none;">
    <div class="bulk-actions-inner d-flex align-items-center justify-content-between">
      <span id="selectedCount" class="font-weight-bold" style="color: white; font-size: 14px;">0 Selected</span>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <button id="bulkArchiveBtn" class="btn btn-warning btn-sm" style="background: #f59e0b; border: none; color: white; padding: 6px 12px; border-radius: 4px; cursor: pointer;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: middle;"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>
          Archive Selected
        </button>
        <button id="bulkResendBtn" class="btn btn-info btn-sm" style="background: #3b82f6; border: none; color: white; padding: 6px 12px; border-radius: 4px; cursor: pointer;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: middle;"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          Resend Reminders
        </button>
        <button id="bulkDeleteBtn" class="btn btn-danger btn-sm" style="background: #ef4444; border: none; color: white; padding: 6px 12px; border-radius: 4px; cursor: pointer;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: middle;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
          Delete Selected
        </button>
      </div>
    </div>
  </div>

  <!-- Table Section -->
  <div class="table-container table-responsive">
    <table class="contracts-table" id="contractsTable">
      <thead>
        <tr>
          <th width="40"><input type="checkbox" id="selectAllCb" class="cb-custom"></th>
          <th>Contract Name</th>
          <th>Party</th>
          <th>Type</th>
          <th>Category</th>
          <th>Status</th>
          <th>Start Date</th>
          <th>Expiry Date</th>
          <th>Last Modified</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof contracts !== 'undefined' && contracts.length > 0) { %>
          <% contracts.forEach((c, index) => { 
            // Mock category mapping based on string search
            let catName = 'Service Agreement';
            let catColor = 'green';
            let iconSvg = '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>';
            
            const title = (c.project_name || c.id || '').toLowerCase();
            if (title.includes('development') || title.includes('website')) {
              catName = 'Project Agreement';
              catColor = 'blue';
              iconSvg = '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>';
            } else if (title.includes('nda') || title.includes('legal') || title.includes('partnership')) {
              catName = 'Legal Agreement';
              catColor = 'purple';
              iconSvg = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>';
            } else if (title.includes('payment') || title.includes('financial')) {
              catName = 'Financial Agreement';
              catColor = 'yellow';
              iconSvg = '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M12 12h.01"/><path d="M17 12h.01"/><path d="M7 12h.01"/>';
            } else if (title.includes('seo')) {
              catColor = 'orange';
              iconSvg = '<rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/>';
            }

            // Date mapping
            const startDate = new Date(c.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
            let expiryDate = '-';
            let isExpiringSoon = false;
            if (c.expires_at) {
              const exp = new Date(c.expires_at);
              expiryDate = exp.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
              
              const daysLeft = (exp - new Date()) / (1000 * 60 * 60 * 24);
              if (daysLeft > 0 && daysLeft <= 14) isExpiringSoon = true;
            }

            // Status mapping
            let displayStatus = 'Draft';
            let statusClass = 'status-gray';
            if (c.status === 'signed' || c.status === 'completed') {
              displayStatus = 'Completed';
              statusClass = 'status-green-light';
            } else if (c.status === 'sent' || c.status === 'opened') {
              if (isExpiringSoon) {
                displayStatus = 'Expiring Soon';
                statusClass = 'status-yellow';
              } else {
                displayStatus = 'Active';
                statusClass = 'status-green';
              }
            } else if (c.status === 'declined') {
              displayStatus = 'Declined';
              statusClass = 'status-red';
            } else if (c.status === 'generation_failed') {
              displayStatus = 'Failed (Retry)';
              statusClass = 'status-red';
            }
          %>
            <tr data-status="<%= displayStatus.toLowerCase() %>" data-category="<%= catName.toLowerCase() %>">
              <td><input type="checkbox" class="cb-custom row-cb" value="<%= c.id %>"></td>
              <td>
                <div class="name-col">
                  <div class="icon-circle icon-<%= catColor %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><%- iconSvg %></svg>
                  </div>
                  <div>
                    <div class="contract-title"><%= c.project_name || 'Untitled Contract' %></div>
                    <div class="contract-id">CON-2025-<%= String(c.id).padStart(4, '0') %></div>
                  </div>
                </div>
              </td>
              <td class="text-sm"><%= c.client_name || c.client_company || 'Unknown Party' %></td>
              <td class="text-sm"><%= catName %></td>
              <td><span class="badge-pill badge-<%= catColor %>"><%= catName %></span></td>
              <td><span class="badge-pill <%= statusClass %>"><%= displayStatus %></span></td>
              <td class="text-sm"><%= startDate %></td>
              <td class="text-sm <%= isExpiringSoon ? 'text-orange' : '' %>"><%= expiryDate %></td>
              <td class="text-sm">
                <%= startDate %><br>
                <span class="text-muted">by Admin</span>
              </td>
              <td>
                <div class="action-buttons" style="position: relative;">
                  <% if (c.status === 'generation_failed') { %>
                    <button class="btn-icon" onclick="retryPdfGeneration(<%= c.id %>)" title="Retry PDF Generation" style="color: #ef4444;">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                    </button>
                  <% } else { %>
                    <a href="/admin/contracts/<%= c.id %>" class="btn-icon" title="View">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                    </a>
                  <% } %>
                  <button class="btn-icon more-btn" title="More Options" data-id="<%= c.id %>" data-uuid="<%= c.uuid %>" data-status="<%= c.status %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg>
                  </button>
                  <div class="dropdown-menu-custom shadow-sm" id="dropdown-<%= c.id %>">
                    <a href="#" class="dropdown-item copy-link-btn" data-url="/c/<%= c.uuid %>">Copy Link</a>
                    <a href="/admin/contracts/<%= c.id %>" class="dropdown-item">Edit<%= (c.status === 'signed' || c.status === 'completed') ? ' & Resend' : '' %></a>
                    <% if (c.status === 'signed' || c.status === 'completed') { %>
                      <a href="/c/<%= c.uuid %>/download" class="dropdown-item" style="color: #16a34a; font-weight: 500;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 4px; vertical-align: middle;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        Download PDF
                      </a>
                    <% } %>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item text-danger delete-btn" data-id="<%= c.id %>" data-status="<%= c.status %>">Delete</a>
                  </div>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="10" class="text-center py-5 text-muted">No contracts found.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <div class="pagination-bar mt-4">
    <div class="page-info">
      Showing 1 to <%= typeof contracts !== 'undefined' ? contracts.length : 0 %> of <%= typeof contracts !== 'undefined' ? contracts.length : 0 %> contracts
    </div>
    <div class="page-controls">
      <button class="btn-page"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg></button>
      <button class="btn-page active">1</button>
      <button class="btn-page">2</button>
      <button class="btn-page">3</button>
      <button class="btn-page">4</button>
      <button class="btn-page">5</button>
      <button class="btn-page" style="pointer-events: none;">...</button>
      <button class="btn-page"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg></button>
    </div>
    <div class="page-size">
      <select class="filter-select" style="min-width: 120px;">
        <option>10 per page</option>
        <option>25 per page</option>
        <option>50 per page</option>
      </select>
    </div>
  </div>
</div>

<!-- ========================================== -->
<!-- MOBILE CONTRACTS VIEW (<=768px)            -->
<!-- ========================================== -->
<div class="mobile-contracts-view">
  <!-- Top Header Row -->
  <div class="mc-header-row">
    <div class="mc-title-group">
      <h1 class="mc-page-title">Contracts</h1>
      <p class="mc-page-subtitle">Manage, track and monitor all your contracts.</p>
    </div>
    <a href="/admin/contracts/new" class="mc-new-btn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      <span>New Contract</span>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: -2px;">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </a>
  </div>

  <!-- 5-Stat Strip / Carousel -->
  <%
    const totalCount = typeof stats !== 'undefined' ? stats.total : (typeof contracts !== 'undefined' ? contracts.length : 0);
    const pendingCount = typeof stats !== 'undefined' ? stats.pending : 0;
    const completedCount = typeof stats !== 'undefined' ? stats.completed : 0;
    const reviewCount = typeof stats !== 'undefined' ? stats.in_review : 0;
    const expiredCount = typeof stats !== 'undefined' ? stats.expired : 0;
  %>
  <div class="mc-stat-strip">
    <div class="mc-stat-col" onclick="filterMobileContracts('all')">
      <div class="mc-stat-icon" style="background: #ECFDF5; color: #10B981;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
      </div>
      <div class="mc-stat-val"><%= totalCount %></div>
      <div class="mc-stat-lbl">Total Contracts</div>
      <div class="mc-stat-trend trend-up">↑ 20%</div>
    </div>

    <div class="mc-stat-divider"></div>

    <div class="mc-stat-col" onclick="filterMobileContracts('pending')">
      <div class="mc-stat-icon" style="background: #EFF6FF; color: #3B82F6;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
      </div>
      <div class="mc-stat-val" style="color: #2563eb;"><%= pendingCount %></div>
      <div class="mc-stat-lbl">Pending</div>
      <div class="mc-stat-trend trend-up">↑ 12%</div>
    </div>

    <div class="mc-stat-divider"></div>

    <div class="mc-stat-col" onclick="filterMobileContracts('completed')">
      <div class="mc-stat-icon" style="background: #ECFDF5; color: #10B981;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
      </div>
      <div class="mc-stat-val" style="color: #10B981;"><%= completedCount %></div>
      <div class="mc-stat-lbl">Completed</div>
      <div class="mc-stat-trend trend-up">↑ 15%</div>
    </div>

    <div class="mc-stat-divider"></div>

    <div class="mc-stat-col" onclick="filterMobileContracts('in_review')">
      <div class="mc-stat-icon" style="background: #F5F3FF; color: #8B5CF6;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
      </div>
      <div class="mc-stat-val" style="color: #8B5CF6;"><%= reviewCount %></div>
      <div class="mc-stat-lbl">In Review</div>
      <div class="mc-stat-trend" style="color: #94A3B8;">—</div>
    </div>

    <div class="mc-stat-divider"></div>

    <div class="mc-stat-col" onclick="filterMobileContracts('expired')">
      <div class="mc-stat-icon" style="background: #FEF2F2; color: #EF4444;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
      </div>
      <div class="mc-stat-val" style="color: #EF4444;"><%= expiredCount %></div>
      <div class="mc-stat-lbl">Expired</div>
      <div class="mc-stat-trend trend-down">↓ 5%</div>
    </div>
  </div>

  <!-- Search & Filter Controls -->
  <div class="mc-search-row">
    <div class="mc-search-input-wrap">
      <svg class="mc-search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      <input type="text" id="mcSearchInput" class="mc-search-input" placeholder="Search contracts..." oninput="handleMobileContractSearch(this.value)">
    </div>
    <button type="button" class="mc-btn-control" onclick="toggleMobileFilterOptions()">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="21" x2="4" y2="14"></line><line x1="4" y1="10" x2="4" y2="3"></line><line x1="12" y1="21" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="3"></line><line x1="20" y1="21" x2="20" y2="16"></line><line x1="20" y1="12" x2="20" y2="3"></line><line x1="1" y1="14" x2="7" y2="14"></line><line x1="9" y1="8" x2="15" y2="8"></line><line x1="17" y1="16" x2="23" y2="16"></line></svg>
      <span>Filter</span>
    </button>
    <button type="button" class="mc-btn-control mc-btn-icon-only" onclick="toggleMobileSortOptions()" aria-label="Sort">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="21" y1="4" x2="14" y2="4"></line><line x1="10" y1="4" x2="3" y2="4"></line><line x1="21" y1="12" x2="12" y2="12"></line><line x1="8" y1="12" x2="3" y2="12"></line><line x1="21" y1="20" x2="16" y2="20"></line><line x1="12" y1="20" x2="3" y2="20"></line><line x1="14" y1="2" x2="14" y2="6"></line><line x1="8" y1="10" x2="8" y2="14"></line><line x1="16" y1="18" x2="16" y2="22"></line></svg>
    </button>
  </div>

  <!-- Status Filter Tabs -->
  <div class="mc-status-bar" id="mcStatusBar">
    <button type="button" class="mc-status-tab active" data-status="all" onclick="filterMobileContracts('all', this)">All Contracts</button>
    <button type="button" class="mc-status-tab" data-status="draft" onclick="filterMobileContracts('draft', this)">Draft</button>
    <button type="button" class="mc-status-tab" data-status="pending" onclick="filterMobileContracts('pending', this)">Pending</button>
    <button type="button" class="mc-status-tab" data-status="completed" onclick="filterMobileContracts('completed', this)">Completed</button>
    <button type="button" class="mc-status-tab" data-status="expired" onclick="filterMobileContracts('expired', this)">Expired</button>
  </div>

  <!-- Contract Cards List -->
  <div class="mc-list" id="mcContractList">
    <% if (typeof contracts !== 'undefined' && contracts.length > 0) { %>
      <% contracts.forEach((c, index) => { 
        const contractId = 'CON-2026-' + String(c.id).padStart(5, '0');
        const formattedDate = new Date(c.created_at || Date.now()).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        
        let statusGroup = 'draft';
        let badgeClass = 'completed';
        let badgeText = 'Completed';
        let badgeIcon = '<polyline points="20 6 9 17 4 12"></polyline>';
        let iconBg = '#ECFDF5';
        let iconColor = '#10B981';
        let cardIconSvg = '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line>';

        if (c.status === 'signed' || c.status === 'completed') {
          statusGroup = 'completed';
          badgeClass = 'completed';
          badgeText = 'Completed';
          badgeIcon = '<polyline points="20 6 9 17 4 12"></polyline>';
          iconBg = '#ECFDF5';
          iconColor = '#10B981';
        } else if (c.status === 'opened' || c.status === 'filled') {
          statusGroup = 'in_review';
          badgeClass = 'review';
          badgeText = 'In Review';
          badgeIcon = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle>';
          iconBg = '#F5F3FF';
          iconColor = '#8B5CF6';
