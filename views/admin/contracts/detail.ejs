<div class="contract-detail-grid">
  <div class="main-col">
    <div class="card mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 style="font-size: clamp(1.25rem, 3vw, 1.75rem); margin-bottom: 0;"><%= typeof contract !== 'undefined' ? (contract.project_name || contract.id) : 'Project Name' %></h2>
        <span class="badge badge-<%= typeof contract !== 'undefined' ? contract.status.toLowerCase() : 'sent' %>"><%= typeof contract !== 'undefined' ? contract.status : 'Sent' %></span>
      </div>
      <p><strong>Client:</strong> <%= typeof contract !== 'undefined' ? contract.client_name : 'Client Name' %></p>
      <p><strong>Amount:</strong> <%= typeof contract !== 'undefined' && contract.total_amount ? contract.total_amount : 'Not specified' %></p>
      <div class="mt-4 detail-action-buttons">
        <button id="copyLinkBtn" class="btn btn-secondary" data-url="<%= typeof appUrl !== 'undefined' ? appUrl : 'http://localhost:3000' %>/c/<%= contract.uuid %>">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
          Copy Link
        </button>
        <form id="sendEmailForm" action="/admin/contracts/<%= contract.id %>/send" method="POST" style="display: inline-block;">
          <button type="submit" id="sendEmailBtn" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            Send via Email
          </button>
        </form>
        <% if (contract.status === 'draft') { %>
          <a href="/admin/contracts/<%= contract.id %>/edit" class="btn btn-outline-primary" style="border: 1px solid var(--portal-primary); color: var(--portal-primary);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Edit Contract
          </a>
        <% } %>
        <% if (contract.status === 'signed' || contract.status === 'completed') { %>
          <a href="/c/<%= contract.uuid %>/download" class="btn btn-success" style="background: #16a34a; color: white;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Download PDF
          </a>
        <% } %>
        <a href="/admin/contracts/<%= contract.id %>/versions" class="btn btn-outline-secondary" style="border: 1px solid #6c757d; color: #6c757d;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          Version History
        </a>
      </div>
    </div>
  </div>
  
  <div class="side-col">
    <div class="card">
      <h3 class="mb-3">Tracking</h3>
      <div class="timeline">
        <div class="timeline-item">
          <strong>Sent</strong>
          <div class="text-muted small"><%= contract.sent_at ? new Date(contract.sent_at).toLocaleString() : 'Not Sent' %></div>
        </div>
        <div class="timeline-item">
          <strong>Opened</strong>
          <div class="text-muted small"><%= contract.first_opened_at ? new Date(contract.first_opened_at).toLocaleString() : 'Pending' %></div>
        </div>
        <div class="timeline-item" style="opacity: <%= contract.signed_at ? '1' : '0.5' %>;">
          <strong>Signed</strong>
          <div class="text-muted small"><%= contract.signed_at ? new Date(contract.signed_at).toLocaleString() : 'Pending' %></div>
        </div>
      </div>
      <% if (contract.status === 'declined') { %>
      <div class="timeline mt-3">
        <div class="timeline-item" style="border-left-color: var(--portal-danger);">
          <strong class="text-danger">Declined</strong>
          <div class="text-muted small"><%= contract.declined_at ? new Date(contract.declined_at).toLocaleString() : 'Pending' %></div>
        </div>
      </div>
      <% } %>
      
      <% if (contract.signature_ip) { %>
      <hr>
      <h4 class="mb-2 mt-3" style="font-size: 0.9rem;">Advanced Analytics</h4>
      <div class="text-muted small">
        <p class="mb-1"><strong>Signature IP:</strong> <%= contract.signature_ip %></p>
        <p class="mb-1"><strong>Device:</strong> <%= contract.signature_user_agent ? contract.signature_user_agent.split(' ')[1] + ' (Parsed)' : 'Unknown' %></p>
        <% if (contract.expires_at) { %>
        <p class="mb-0"><strong>Expires:</strong> <span style="color: var(--portal-danger);"><%= new Date(contract.expires_at).toLocaleDateString() %></span></p>
        <% } %>
      </div>
      <% } else if (contract.expires_at) { %>
      <hr>
      <h4 class="mb-2 mt-3" style="font-size: 0.9rem;">Advanced Analytics</h4>
      <div class="text-muted small">
        <p class="mb-0"><strong>Expires:</strong> <span style="color: var(--portal-danger);"><%= new Date(contract.expires_at).toLocaleDateString() %></span></p>
      </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  document.getElementById('copyLinkBtn').addEventListener('click', function() {
    const url = this.getAttribute('data-url');
    navigator.clipboard.writeText(url).then(() => {
      const originalText = this.innerText;
      this.innerText = 'Copied!';
      setTimeout(() => this.innerText = originalText, 2000);
    });
  });

  const sendEmailForm = document.getElementById('sendEmailForm');
  if (sendEmailForm) {
    sendEmailForm.addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = document.getElementById('sendEmailBtn');
      const originalText = btn.innerText;
      btn.innerText = 'Sending...';
      btn.disabled = true;
      
      try {
        const response = await fetch(this.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const result = await response.json();
        
        if (result.success) {
          alert('Email sent successfully!');
          window.location.reload();
        } else {
          alert(result.error || 'Failed to send email.');
          btn.innerText = originalText;
          btn.disabled = false;
        }
      } catch (err) {
        alert('A network error occurred.');
        btn.innerText = originalText;
        btn.disabled = false;
      }
    });
  }
</script>

<style>
.contract-detail-grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
}
.detail-action-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  align-items: center;
}
@media (max-width: 992px) {
  .contract-detail-grid {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
}
@media (max-width: 576px) {
  .detail-action-buttons {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }
  .detail-action-buttons .btn,
  .detail-action-buttons form,
  .detail-action-buttons form .btn,
  .detail-action-buttons a {
    width: 100%;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
  }
  .main-col .card,
  .side-col .card {
    padding: 1.25rem;
  }
}
</style>
