<div class="dashboard-middle">
  <!-- Contracts Overview Chart -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3 class="dashboard-card-title">Contracts Overview</h3>
      <select class="form-control" style="width: auto; padding: 0.25rem 0.5rem; font-size: 0.75rem;">
        <option>This Month</option>
        <option>Last Month</option>
      </select>
    </div>
    
    <% if (typeof stats !== 'undefined' && stats.total > 0) { %>
      <div style="position: relative; height: 300px; width: 100%; display: flex; justify-content: center; align-items: center; padding: 20px 0;">
        <canvas id="contractsChart"></canvas>
      </div>
      
      <script>
        document.addEventListener('DOMContentLoaded', function() {
          const canvas = document.getElementById('contractsChart');
          if (!canvas || typeof Chart === 'undefined') return;
          const ctx = canvas.getContext('2d');
          
          const stats = {
            active: <%= stats.active || 0 %>,
            expiringSoon: <%= stats.expiringSoon || 0 %>,
            completed: <%= stats.completed || 0 %>,
            declined: <%= stats.declined || 0 %>,
            total: <%= stats.total || 0 %>
          };
          const draft = Math.max(0, stats.total - stats.active - stats.completed - stats.declined);

          const style = getComputedStyle(document.body);
          const colorPrimary = style.getPropertyValue('--portal-primary').trim() || '#347A5A';
          const colorAccent = style.getPropertyValue('--portal-accent').trim() || '#FFDE59';
          const colorInfo = style.getPropertyValue('--portal-info').trim() || '#3B82F6';
          const colorDanger = style.getPropertyValue('--portal-danger').trim() || '#EF4444';
          const colorMuted = style.getPropertyValue('--portal-text-muted').trim() || '#64748B';
          const textColor = style.getPropertyValue('--portal-text').trim() || '#334155';

          const chart = new Chart(ctx, {
            type: 'doughnut',
            data: {
              labels: ['Active', 'Expiring Soon', 'Completed', 'Declined', 'Draft/Sent'],
              datasets: [{
                data: [stats.active, stats.expiringSoon, stats.completed, stats.declined, draft],
                backgroundColor: [colorPrimary, colorAccent, colorInfo, colorDanger, colorMuted],
                borderWidth: 0,
                hoverOffset: 4
              }]
            },
            options: {
              responsive: true,
              maintainAspectRatio: false,
              cutout: '70%',
              plugins: {
                legend: {
                  position: window.innerWidth <= 576 ? 'bottom' : 'right',
                  labels: {
                    color: textColor,
                    font: { family: "'Inter', sans-serif", size: 12 },
                    padding: 15,
                    usePointStyle: true,
                    pointStyle: 'circle'
                  }
                },
                tooltip: {
                  backgroundColor: 'rgba(30, 41, 59, 0.9)',
                  titleFont: { family: "'Inter', sans-serif", size: 13 },
                  bodyFont: { family: "'Inter', sans-serif", size: 12 },
                  padding: 12,
                  cornerRadius: 8,
                  callbacks: {
                    label: function(context) {
                      let label = context.label || '';
                      if (label) label += ': ';
                      if (context.parsed !== null) {
                        label += context.parsed;
                        label += ' (' + ((context.parsed / stats.total) * 100).toFixed(1) + '%)';
                      }
                      return label;
                    }
                  }
                }
              }
            }
          });

          window.addEventListener('resize', function() {
            const newPos = window.innerWidth <= 576 ? 'bottom' : 'right';
            if (chart.options.plugins.legend.position !== newPos) {
              chart.options.plugins.legend.position = newPos;
              chart.update();
            }
          });

          const observer = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
              if (mutation.attributeName === "data-theme") {
                const newStyle = getComputedStyle(document.body);
                chart.options.plugins.legend.labels.color = newStyle.getPropertyValue('--portal-text').trim();
                chart.update();
              }
            });
          });
          observer.observe(document.documentElement, { attributes: true });
        });
      </script>
    <% } else { %>
      <div style="height: 300px; width: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 20px 0; color: #94a3b8;">
        <div style="width: 160px; height: 160px; border: 12px solid #f1f5f9; border-radius: 50%; margin-bottom: 20px; box-sizing: border-box;"></div>
        <p style="margin: 0; font-size: 0.9rem;">No contracts found</p>
      </div>
    <% } %>
    
    <a href="/admin/contracts" style="display: block; margin-top: 1.5rem; color: var(--portal-primary); font-size: 0.875rem; font-weight: 500; text-decoration: none;">View Full Report &rarr;</a>
  </div>

  <!-- Upcoming Expirations -->
  <div class="dashboard-card">
    <div class="dashboard-card-header">
      <h3 class="dashboard-card-title">Upcoming Expirations</h3>
      <a href="/admin/contracts?status=expiring" style="color: var(--portal-primary); font-size: 0.875rem; font-weight: 500; text-decoration: none;">View All &rarr;</a>
    </div>
    <div class="list-container">
      <% if (typeof upcomingExpirations !== 'undefined' && upcomingExpirations.length > 0) { %>
        <% upcomingExpirations.forEach(exp => { 
             const daysLeft = Math.ceil((new Date(exp.expires_at_calculated) - new Date()) / (1000 * 60 * 60 * 24));
        %>
          <div class="list-item">
            <div class="list-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></div>
            <div class="list-content">
              <div class="list-title"><%= exp.project_name %></div>
              <div class="list-subtitle"><%= exp.client_name || exp.client_email %></div>
            </div>
            <div class="list-meta">
              <div class="list-date"><%= new Date(exp.expires_at_calculated).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></div>
              <div class="list-status" style="<%= daysLeft <= 14 ? 'color: var(--portal-danger);' : '' %>">In <%= daysLeft %> days</div>
            </div>
            <span class="badge badge-expiring-soon" style="margin-left: 1rem;">Expiring Soon</span>
          </div>
        <% }) %>
      <% } else { %>
        <div class="p-4 text-center text-muted" style="font-size: 0.875rem;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="opacity: 0.5; margin-bottom: 0.5rem;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          <br>No contracts expiring soon.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Actions Sidebar -->
  <div class="dashboard-card" style="display: flex; flex-direction: column;">
    <h3 class="dashboard-card-title mb-4">Quick Actions</h3>
    
    <div class="action-list">
      <a href="/admin/contracts/new" class="action-btn" style="text-decoration: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New Contract
      </a>
      <a href="/admin/contracts/new" class="action-btn" style="text-decoration: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        View Templates
      </a>
    </div>

    <div class="promo-box mt-auto">
      <h4>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        Streamline Your Contract Workflow
      </h4>
      <p>Create, manage & track contracts efficiently in one place.</p>
      <a href="/admin/contracts/new" class="btn btn-primary" style="width: 100%; justify-content: space-between;">
        Explore Templates &rarr;
      </a>
    </div>
  </div>
</div>

<div class="card recent-contracts">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h3 style="font-size: 1rem; font-weight: 600; margin: 0;">Recent Contracts</h3>
    <a href="/admin/contracts" style="color: var(--portal-primary); font-size: 0.875rem; font-weight: 500; text-decoration: none;">View All Contracts &rarr;</a>
  </div>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Contract Name</th>
          <th>Party</th>
          <th>Type</th>
          <th>Status</th>
          <th>Start Date</th>
          <th>Expiry Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof contracts !== 'undefined' && contracts.length > 0) { %>
          <% contracts.slice(0, 5).forEach(c => { %>
            <tr>
              <td style="font-weight: 500;"><%= c.project_name || c.id %></td>
              <td class="text-muted"><%= c.client_name || 'N/A' %></td>
              <td class="text-muted">Service Agreement</td>
              <td><span class="badge badge-<%= c.status.toLowerCase() %>"><%= c.status %></span></td>
              <td class="text-muted"><%= new Date(c.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td style="color: var(--portal-danger);"><%= new Date(new Date(c.created_at).setFullYear(new Date(c.created_at).getFullYear() + 1)).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) %></td>
              <td>
                <div class="d-flex gap-2">
                  <a href="/admin/contracts/<%= c.id %>" class="btn-icon" title="View"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></a>
                  <button class="btn-icon" title="More Options"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg></button>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="7" class="text-center py-5 text-muted">
              <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; opacity: 0.6;">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/></svg>
                <span>No recent contracts found. Start by creating a new contract!</span>
                <a href="/admin/contracts/new" class="btn btn-primary btn-sm">Create Contract</a>
              </div>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
