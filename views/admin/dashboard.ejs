  <div class="mobile-hero-content">
    <div class="mobile-hero-icon">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="7" y1="17" x2="17" y2="7"></line>
        <polyline points="7 7 17 7 17 17"></polyline>
      </svg>
    </div>
    <div class="mobile-hero-text">
      <span class="mobile-hero-sub">Welcome back,</span>
      <h2 class="mobile-hero-title"><%= typeof admin !== 'undefined' && admin.name ? admin.name.split(' ')[0] : 'Aviral' %> 👋</h2>
      <p class="mobile-hero-desc">Manage, track and sign your contracts in one place.</p>
    </div>
  </div>
  <div class="mobile-hero-art">
    <div class="hero-doc-illustration">
      <div class="hero-doc-sheet">
        <div class="doc-line doc-line-green"></div>
