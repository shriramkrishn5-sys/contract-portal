<div class="notifications-page">
  <!-- Header Section -->
  <div class="page-header mb-4">
    <h1 class="page-title">Notifications</h1>
    <p class="page-subtitle">Manage how and when you receive notifications from the Contract Portal.</p>
  </div>

  <!-- Tabs Navigation -->
  <ul class="nav-tabs mb-4">
    <li class="nav-tab active" data-tab="email">Email Notifications</li>
    <li class="nav-tab" data-tab="inapp">In-App Notifications</li>
    <li class="nav-tab" data-tab="reminders">Reminder Preferences</li>
  </ul>

  <!-- Main Content Grid -->
  <div class="settings-grid">
    <!-- Left Column: Forms -->
    <div class="settings-main">
      
      <div class="alert-info mb-4">
        <svg class="alert-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <span>Choose which email notifications you want to receive and who should receive them.</span>
      </div>

      <!-- ==================== EMAIL NOTIFICATIONS TAB ==================== -->
      <div class="settings-pane active" id="tab-email">
        <form id="emailNotificationsForm" class="card mb-4">
          <div class="card-header d-flex justify-content-between align-items-center">
            <div>
              <h3 class="card-title">Email Notification Settings</h3>
              <p class="card-subtitle">Enable or disable email notifications for different events.</p>
            </div>
            <button type="button" class="btn btn-save" onclick="saveNotifications('emailNotificationsForm', this)">Save Changes</button>
          </div>
          
          <div class="table-responsive">
            <div class="notifications-table" style="min-width: 580px;">
              <div class="nt-header">
                <div class="nt-col-title">Notification</div>
                <div class="nt-col-desc">Description</div>
                <div class="nt-col-me">Notify Me</div>
                <div class="nt-col-others">Notify Others <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg></div>
                <div class="nt-col-actions"></div>
              </div>

              <!-- Row: Contract Created -->
              <div class="nt-row">
                <div class="nt-col-title">
                  <div class="nt-icon bg-green-light text-green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="12" y1="18" x2="12" y2="12"></line><line x1="9" y1="15" x2="15" y2="15"></line></svg>
                  </div>
                  <span>Contract Created</span>
                </div>
                <div class="nt-col-desc">When a new contract is created</div>
                <div class="nt-col-me">
                  <label class="toggle-switch">
                    <input type="checkbox" name="notify_me_created" value="true" <%= settings.notify_me_created !== 'false' ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="nt-col-others">
                  <label class="custom-checkbox">
                    <input type="checkbox" name="notify_others_created" value="true" <%= settings.notify_others_created !== 'false' ? 'checked' : '' %>>
                    <span class="checkmark"></span>
                  </label>
                </div>
                <div class="nt-col-actions">
                  <button type="button" class="btn-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2-2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg></button>
                </div>
              </div>

              <!-- Row: Contract Sent -->
              <div class="nt-row">
                <div class="nt-col-title">
                  <div class="nt-icon bg-blue-light text-blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
