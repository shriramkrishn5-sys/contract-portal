<script>
// Tab Switching
document.addEventListener('DOMContentLoaded', () => {
  const navTabs = document.querySelectorAll('.nav-tab[data-tab]');
  const panes = document.querySelectorAll('.settings-pane');

  navTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      navTabs.forEach(n => n.classList.remove('active'));
      panes.forEach(p => p.classList.remove('active'));
      
      tab.classList.add('active');
      document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
    });
  });
});

// Dynamic Save Function
async function saveNotifications(formId, btnElement) {
  const form = document.getElementById(formId);
  if (!form || !btnElement) return;
  
  const originalText = btnElement.innerText;
  btnElement.innerText = 'Saving...';
  btnElement.disabled = true;

  // Capture all standard inputs
  const formData = new FormData(form);
  const payload = Object.fromEntries(formData.entries());

  // Explicitly handle unchecked checkboxes so they override with 'false'
  const checkboxes = form.querySelectorAll('input[type="checkbox"]');
  checkboxes.forEach(cb => {
    payload[cb.name] = cb.checked ? 'true' : 'false';
  });

  try {
    const response = await fetch('/admin/notifications', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });

    const data = await response.json();
    if (data.success) {
      btnElement.innerText = 'Saved!';
      btnElement.style.background = '#15803d';
      setTimeout(() => {
        btnElement.innerText = originalText;
        btnElement.style.background = '';
        btnElement.disabled = false;
      }, 2000);
    }
  } catch (err) {
    console.error(err);
    btnElement.innerText = 'Error!';
    setTimeout(() => {
      btnElement.innerText = originalText;
      btnElement.disabled = false;
    }, 2000);
  }
}
</script>
