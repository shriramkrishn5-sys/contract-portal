<style>
.notifications-page {
  font-family: 'Outfit', sans-serif;
  color: #334155;
  max-width: 1400px;
  margin: 0 auto;
}

.page-title {
  font-size: 24px;
  font-weight: 700;
  color: #0f172a;
  margin: 0 0 4px 0;
}

.page-subtitle {
  font-size: 14px;
  color: #64748b;
  margin: 0;
}

/* Tabs */
.nav-tabs {
  display: flex;
  overflow-x: auto;
  flex-wrap: nowrap;
  -webkit-overflow-scrolling: touch;
  list-style: none;
  padding: 0;
  margin: 0 0 24px 0;
  border-bottom: 2px solid var(--portal-border, #e2e8f0);
  gap: 32px;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.nav-tabs::-webkit-scrollbar {
  display: none;
}
.nav-tab {
  padding: 12px 0;
  font-size: 14px;
  font-weight: 500;
  color: #64748b;
  cursor: pointer;
  position: relative;
  white-space: nowrap;
  flex-shrink: 0;
}
.nav-tab.active {
  color: #237648;
}
.nav-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: #237648;
}

/* Grid Layout */
.settings-grid {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 24px;
  align-items: start;
}

@media (max-width: 992px) {
  .settings-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .form-grid {
    grid-template-columns: 1fr !important;
  }
  .form-grid .form-group {
    grid-column: auto !important;
    grid-row: auto !important;
  }
}

/* Alert Banner */
.alert-info {
  background: #f0fdf4;
  border: 1px solid #dcfce7;
  border-radius: 6px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  color: #166534;
  font-size: 13px;
  font-weight: 500;
}
.alert-icon {
  color: #16a34a;
}

/* Content Panes */
.settings-pane {
  display: none;
}
.settings-pane.active {
  display: block;
}

/* Cards */
.card {
  background: white;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  padding: 24px;
}
.card-header {
  margin-bottom: 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}
.card-title {
  font-size: 16px;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 4px 0;
}
.card-subtitle {
  font-size: 13px;
  color: #64748b;
  margin: 0;
}
.btn-save {
  background: #237648;
  color: white;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  border: none;
  cursor: pointer;
  transition: 0.2s;
}
.btn-save:hover {
  background: #1c5e39;
}
.btn-outline {
  background: transparent;
  border: 1px solid #e2e8f0;
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
}

/* Notifications Table */
.notifications-table {
  display: flex;
  flex-direction: column;
}
.nt-header {
  display: flex;
  align-items: center;
  padding-bottom: 12px;
  border-bottom: 1px solid #e2e8f0;
  font-size: 12px;
  font-weight: 600;
  color: #0f172a;
}
.nt-row {
  display: flex;
  align-items: center;
  padding: 16px 0;
  border-bottom: 1px solid #f1f5f9;
}
.nt-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.nt-col-title {
  width: 250px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  font-weight: 600;
  color: #0f172a;
}
.nt-col-desc {
  flex: 1;
  font-size: 13px;
  color: #64748b;
}
.nt-col-me {
  width: 100px;
  text-align: center;
}
.nt-col-others {
  width: 100px;
  text-align: center;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
.nt-col-actions {
  width: 40px;
  text-align: right;
}

/* Icons */
.nt-icon {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bg-green-light { background: #dcfce7; }
.text-green { color: #16a34a; }
.bg-blue-light { background: #e0f2fe; }
.text-blue { color: #0284c7; }
.bg-yellow-light { background: #fef3c7; }
.text-yellow { color: #d97706; }
.bg-purple-light { background: #f3e8ff; }
.text-purple { color: #9333ea; }
.bg-red-light { background: #fee2e2; }
.text-red { color: #dc2626; }
.bg-orange-light { background: #ffedd5; }
.text-orange { color: #ea580c; }
.bg-gray-light { background: #f1f5f9; }
.text-gray { color: #64748b; }

/* Custom Toggle Switch */
.toggle-switch {
  position: relative;
  display: inline-block;
  width: 40px;
  height: 20px;
}
.toggle-switch input {
  opacity: 0;
  width: 0;
  height: 0;
}
.toggle-slider {
  position: absolute;
  cursor: pointer;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: #cbd5e1;
  transition: .4s;
  border-radius: 20px;
}
.toggle-slider:before {
  position: absolute;
  content: "";
  height: 16px;
  width: 16px;
  left: 2px;
  bottom: 2px;
  background-color: white;
  transition: .4s;
  border-radius: 50%;
}
input:checked + .toggle-slider {
  background-color: #237648;
}
input:checked + .toggle-slider:before {
  transform: translateX(20px);
}

/* Custom Checkbox */
.custom-checkbox {
  display: block;
  position: relative;
  padding-left: 20px;
  margin-bottom: 20px;
  cursor: pointer;
  font-size: 22px;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
  user-select: none;
}
.custom-checkbox input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
  height: 0;
  width: 0;
}
.checkmark {
  position: absolute;
  top: 0;
  left: 0;
  height: 18px;
  width: 18px;
  background-color: #f1f5f9;
  border: 1px solid #cbd5e1;
  border-radius: 4px;
  transition: 0.2s;
}
.custom-checkbox:hover input ~ .checkmark {
  background-color: #e2e8f0;
}
.custom-checkbox input:checked ~ .checkmark {
  background-color: #237648;
  border-color: #237648;
}
.checkmark:after {
  content: "";
  position: absolute;
  display: none;
}
.custom-checkbox input:checked ~ .checkmark:after {
  display: block;
}
.custom-checkbox .checkmark:after {
  left: 6px;
  top: 2px;
  width: 5px;
  height: 10px;
  border: solid white;
  border-width: 0 2px 2px 0;
  -webkit-transform: rotate(45deg);
  -ms-transform: rotate(45deg);
  transform: rotate(45deg);
}

/* Icon Buttons */
.btn-icon {
