<div class="header-actions" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 30px;">
  <div>
    <h1 class="page-title">Edit Webhook</h1>
    <p class="page-subtitle">Update webhook configuration</p>
  </div>
  <div>
    <a href="/admin/webhooks" class="btn btn-outline">Cancel</a>
  </div>
</div>

<div class="card" style="width: 100%; max-width: 600px;">
  <form action="/admin/webhooks/edit/<%= webhook.id %>" method="POST">
    <div class="form-group" style="margin-bottom: 20px;">
      <label class="form-label">Webhook URL</label>
      <input type="url" name="url" class="form-control" value="<%= webhook.url %>" required>
    </div>
    
    <div class="form-group" style="margin-bottom: 20px;">
      <label class="form-label">Event Type</label>
      <select name="event_type" class="form-control" required>
        <option value="contract.signed" <%= webhook.event_type === 'contract.signed' ? 'selected' : '' %>>contract.signed</option>
      </select>
    </div>
    
    <div class="form-group" style="margin-bottom: 30px;">
      <label style="display: flex; align-items: center; cursor: pointer;">
        <input type="checkbox" name="is_active" <%= webhook.is_active ? 'checked' : '' %> style="margin-right: 10px; width: 16px; height: 16px;">
        <span style="font-weight: 500;">Active</span>
      </label>
    </div>
    
    <button type="submit" class="btn btn-primary">Update Webhook</button>
  </form>
</div>
